---
interface Props {
  name: "phone" | "arrow" | "pin" | "heart" | "home" | "people" | "mail" | "plus";
  class?: string;
}
const { name, class: className = "" } = Astro.props;
const paths = {
  phone: ["m7 3 3 5-3 2c1.6 3.3 3.7 5.4 7 7l2-3 5 3-1 4C10 22 2 14 3 4l4-1Z"],
  arrow: ["M4 12h15M13 5l7 7-7 7"],
  pin: ["M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"],
  heart: ["M20.8 4.6a5.5 5.5 0 0 0-7.8 0l-1 1-1-1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"],
  home: ["m3 10 9-7 9 7v11H3V10Z", "M9 21v-8h6v8"],
  people: ["M3 21v-4a6 6 0 0 1 12 0v4M16 4a3 3 0 0 1 0 6M18 13a5 5 0 0 1 3 4v4"],
  mail: ["m3 6 9 7 9-7"],
  plus: ["M12 5v14M5 12h14"],
};
---
<svg class={`icon ${className}`} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {paths[name].map((d) => <path d={d} />)}
  {name === "pin" && <circle cx="12" cy="10" r="2.5" />}
  {name === "people" && <circle cx="9" cy="7" r="3" />}
  {name === "mail" && <rect x="3" y="5" width="18" height="14" rx="2" />}
</svg>
